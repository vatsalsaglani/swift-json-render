    "bars": {
      "props": {
        "data": {
          "$state": "/runs"
        },
        "format": "compact",
        "layout": "stacked",
        "selection": {
          "$bindState": "/picked"
        },
        "series": "result",
        "x": "run",
        "y": "n"
      },
      "type": "BarChart"
    },
    "card": {
      "children": [
        "bars",
        "picked"
      ],
      "props": {
        "title": "Tests by result"
      },
      "type": "Card"
    },
    "picked": {
      "props": {
        "text": {
