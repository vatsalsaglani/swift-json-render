[
  {
    "id": "dashboard",
    "description": "Operations dashboard panel",
    "root": true,
    "element": {
      "type": "Panel",
      "props": {
        "title": "Operations"
      }
    }
  },
  {
    "id": "stack",
    "description": "A vertical group of related elements",
    "root": true,
    "element": {
      "type": "Stack",
      "props": {}
    },
    "maxUses": 3
  },
  {
    "id": "title_text",
    "description": "Dashboard heading text",
    "root": false,
    "element": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/title"
        }
      }
    }
  },
  {
    "id": "summary_text",
    "description": "One-paragraph summary of the period",
    "root": false,
    "element": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/summary"
        }
      }
    }
  },
  {
    "id": "revenue_stat",
    "description": "Revenue as a single number",
    "root": false,
    "element": {
      "type": "Stat",
      "props": {
        "label": "Revenue",
        "value": {
          "$state": "/revenue/total"
        }
      }
    },
    "resource": "revenue"
  },
  {
    "id": "revenue_chart",
    "description": "Revenue over time as a chart",
    "root": false,
    "element": {
      "type": "Chart",
      "props": {
        "title": "Revenue",
        "series": {
          "$state": "/revenue/series"
        }
      }
    },
    "resource": "revenue"
  },
  {
    "id": "revenue_table",
    "description": "Revenue by region as a table",
    "root": false,
    "element": {
      "type": "Table",
      "props": {
        "title": "Revenue by region",
        "rows": {
          "$state": "/revenue/rows"
        }
      }
    },
    "resource": "revenue"
  },
  {
